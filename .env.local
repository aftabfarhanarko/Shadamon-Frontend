# Next.js public environment variables
# Replace the values with your real client IDs / URLs

NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
NEXT_PUBLIC_FACEBOOK_APP_ID=REPLACE_WITH_FACEBOOK_APP_ID

